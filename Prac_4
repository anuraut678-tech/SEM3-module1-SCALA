package prac_4

import breeze.linalg._
object DenseVectorBreeze {

  def main(args: Array[String]): Unit = {

    // Create dense vectors
    val v1 = DenseVector(7.0, 1.0, 9.0, 3.0, 6.0)
    val v2 = DenseVector(2.0, 8.0, 4.0, 5.0, 1.0)

    println(s"Vector v1: $v1")
    println(s"Vector v2: $v2")

    // Sum of elements
    val sum = breeze.linalg.sum(v1)
    println(f"Sum of v1: $sum%.2f")

    // Mean of elements
    val mean = breeze.stats.mean(v1)
    println(f"Mean of v1: $mean%.2f")

    // Dot product
    val dotProduct = v1 dot v2
    println(f"Dot Product of v1 and v2: $dotProduct%.2f")

    // Sparse Vector
    val sparseVec = SparseVector(5.0, 0.0, 0.0, 8.0, 1.0, 0.0, 7.0)

    println(s"Sparse Vector: $sparseVec")

    // Convert Sparse Vector to Dense Vector
    val denseVec = DenseVector(sparseVec.toArray)

    println(s"Dense Vector from Sparse: $denseVec")
  }
}
