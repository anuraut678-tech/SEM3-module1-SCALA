package prac_5

import breeze.linalg._
import scala.util.Random

object MatrixTranspose {

  def main(args: Array[String]): Unit = {

    val rows = 3
    val cols = 3

    // Generate a 3×3 matrix with random integers from 11 to 25
    val randData = Array.fill(rows * cols)(Random.nextInt(10) + 11)

    val randMatrix = new DenseMatrix(rows, cols, randData)

    println("Random Matrix:")
    println(randMatrix)

    // Transpose of the matrix
    val transpose = randMatrix.t
    println("\nTranspose Matrix:")
    println(transpose)

    // Determinant
    val determinant = det(randMatrix.map(_.toDouble))
    println(f"\nDeterminant: $determinant%.2f")
  }
}
